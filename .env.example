# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ — this key bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp click-to-chat number, E.164 format without "+" (e.g. 919999999999).
# Can also be set from /admin/settings once the app is running.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public site URL used for canonical links, sitemap.xml, and OG tags.
# No production domain is assigned yet — set this once one exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
